{
  "name": "music-downloader",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "predev": "node scripts/copy-ffmpeg.mjs && node scripts/prepare-server.mjs",
    "build": "next build --webpack",
    "prebuild": "node scripts/copy-ffmpeg.mjs && node scripts/prepare-server.mjs",
    "start": "node .next/standalone/server.js",
    "typecheck": "node scripts/prepare-server.mjs && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "node .next/standalone/server.js",
    "postbuild": "node scripts/package-server.mjs",
    "build:helper": "node scripts/build-helper.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "next": "^16.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "spotify-url-info": "^3.3.3",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "5.16.3",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@yao-pkg/pkg": "6.24.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
