{
  "manifest_version": 3,
  "name": "MusicDownloader Browser Connection",
  "version": "1.0.1",
  "description": "Connect your signed-in music sessions to the MusicDownloader helper on this computer.",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*.youtube.com/*", "https://*.soundcloud.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "MusicDownloader connection" },
  "incognito": "not_allowed",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
